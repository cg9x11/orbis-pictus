# ============================================================================
# .env - SECRETS ONLY. Copy to `.env` (gitignored) and fill in.
#
# Non-secret configuration (provider selection, models, feature flags, tunables)
# now lives in `config.yml` - see config.example.yml. Precedence is:
#
#     UI settings panel   >   environment variable   >   config.yml   >   built-in default
#
# so any config.yml value can still be overridden by setting its env var here or
# in the deployment environment (the override names are listed at the bottom).
#
# The image/video provider and model can additionally be chosen per browser from
# the app's "Models" toolbar panel, which sits above env. Nothing here is secret
# in that panel - API keys are never sent to the client, only whether each one is
# present. See the README.
# ============================================================================

# --- API keys (secrets) ---
# LLM: prompt author, tap VLM, and the web-search model (anthropic Messages API / proxy).
LLM_API_KEY=
# Image/video: BytePlus Ark (ModelArk).
ARK_API_KEY=
# Image: fal.ai (used when image.provider = fal).
FAL_KEY=
# LLM (llm.provider = gemini) AND image (image.provider = gemini, "nano banana") - same key.
GEMINI_API_KEY=
# Image: OpenAI gpt-image (used when image.provider = openai).
OPENAI_API_KEY=

# --- Optional: point at a config file other than ./config.yml ---
# CONFIG_FILE=./config.yml

# ============================================================================
# Optional env overrides (leave unset to use config.yml / defaults). Uncomment
# only what you want to force from the environment.
# ============================================================================
# server
# PORT=8787
# DATABASE_URL=./data/orbis.db
# IMAGES_DIR=./data/images

# llm - unset, the provider is picked from which key exists above:
# LLM_API_KEY -> anthropic, else GEMINI_API_KEY -> gemini, else mock.
# The server prints what it resolved at startup - check that line.
# LLM_PROVIDER=anthropic            # anthropic | gemini | mock
# LLM_BASE_URL=https://api.anthropic.com   # default - the real Anthropic API (NO /v1 suffix).
#                                   # An Anthropic-compatible proxy goes here instead, and then the
#                                   # model ids below must be the proxy's own, e.g.
#                                   # LLM_BASE_URL=http://localhost:20128 with cc/claude-sonnet-5.
# PROMPT_AUTHOR_MODEL=claude-sonnet-5
# TAP_VLM_MODEL=claude-haiku-4-5

# image
# IMAGE_PROVIDER=fal                # fal | ark | gemini | openai | mock
# IMAGE_MODEL=fal-ai/flux/schnell   # fal model; e.g. fal-ai/nano-banana for quality
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com
# ARK_IMAGE_MODEL=seedream-4-5-251128
# ARK_IMAGE_MODEL_FALLBACK=seedream-4-0-250828
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# GEMINI_IMAGE_SIZE=1K              # 512 | 1K | 2K | 4K
# GEMINI_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_IMAGE_QUALITY=medium       # low | medium | high
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1

# video / morph (experimental - burns quota fast, keep off unless testing)
# VIDEO_ENABLED=false
# VIDEO_PROVIDER=mock               # ark | mock
# ARK_VIDEO_MODEL=seedance-1-0-pro-250528
# VIDEO_RESOLUTION=480p             # 480p | 720p | 1080p
# VIDEO_DURATION_SECONDS=5
# VIDEO_MAX_PER_SESSION=5
# MORPH_ENABLED=false
# MORPH_MAX_PER_SESSION=5
# ARK_VIDEO_MORPH_MODEL=seedance-1-0-pro-250528   # flf2v-capable model for morphs
# MORPH_REVERSE=true                # re-encode each morph backwards (needs ffmpeg on PATH) so
                                    # stepping back to the parent replays the same transition;
                                    # costs no video quota. Off = back-navigation crossfades.

# web search
# SEARCH_PROVIDER=llm               # llm | none (unset = llm when LLM_API_KEY is set, else none)
# SEARCH_MODEL=claude-sonnet-5      # proxy setups use the proxy's own id, e.g. cc/claude-sonnet-5
# SEARCH_TIMEOUT_MS=45000
# SEARCH_CACHE_ENABLED=false

# visual identity
# ART_STYLE=felt                    # felt | papercut | riso | pixel | editorial
# COMPOSITION=diorama               # flat | isometric | diorama

# misc
# UPLOAD_ENABLED=false
# TAP_DEDUP=reuse                   # reuse | variant | off
# DEBUG_IMAGE_PROMPT=false
