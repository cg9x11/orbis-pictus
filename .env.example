# --- LLM provider (prompt author + tap VLM) ---
LLM_PROVIDER=anthropic         # anthropic | gemini | mock
GEMINI_API_KEY=

# anthropic provider: Anthropic Messages API (NOT OpenAI-compatible), e.g. a local proxy.
# @anthropic-ai/sdk requests {LLM_BASE_URL}/v1/messages, so LLM_BASE_URL has NO /v1 suffix.
LLM_BASE_URL=http://localhost:20128
LLM_API_KEY=
PROMPT_AUTHOR_MODEL=cc/claude-sonnet-5
TAP_VLM_MODEL=cc/claude-haiku-4-5

# --- Image provider ---
IMAGE_PROVIDER=fal             # ark | fal | mock
FAL_KEY=
IMAGE_MODEL=fal-ai/flux/schnell   # cheap default; set to fal-ai/nano-banana for quality

# ark provider: BytePlus Ark (ModelArk) images API.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com
ARK_IMAGE_MODEL=seedream-4-5-251128
ARK_IMAGE_MODEL_FALLBACK=seedream-4-0-250828

# --- Web search provider ---
SEARCH_PROVIDER=llm            # llm | none  (defaults to llm when LLM_API_KEY is set)
SEARCH_MODEL=cc/claude-sonnet-5

# --- Server ---
PORT=8787
DATABASE_URL=./data/flipbook.db
IMAGES_DIR=./data/images
