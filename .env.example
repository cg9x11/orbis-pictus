# --- LLM provider (prompt author + tap VLM) ---
LLM_PROVIDER=anthropic         # anthropic | gemini | mock
GEMINI_API_KEY=

# anthropic provider: Anthropic Messages API (NOT OpenAI-compatible), e.g. a local proxy.
# @anthropic-ai/sdk requests {LLM_BASE_URL}/v1/messages, so LLM_BASE_URL has NO /v1 suffix.
LLM_BASE_URL=http://localhost:20128
LLM_API_KEY=
PROMPT_AUTHOR_MODEL=cc/claude-sonnet-5
TAP_VLM_MODEL=cc/claude-haiku-4-5

# --- Image provider ---
IMAGE_PROVIDER=fal             # ark | fal | mock
FAL_KEY=
IMAGE_MODEL=fal-ai/flux/schnell   # cheap default; set to fal-ai/nano-banana for quality

# ark provider: BytePlus Ark (ModelArk) images API.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com
ARK_IMAGE_MODEL=seedream-4-5-251128
ARK_IMAGE_MODEL_FALLBACK=seedream-4-0-250828

# --- Idle-loop video (PLAN §3 Phase 5, experimental) ---
# Master switch, default false: nothing calls Seedance unless this is explicitly "true". Video
# burns Free Credit Only quota far faster than images — keep this off except when deliberately
# testing the feature.
VIDEO_ENABLED=false
VIDEO_PROVIDER=mock            # ark | mock — defaults to mock even if ARK_API_KEY is set (see providers/index.ts)
ARK_VIDEO_MODEL=seedance-1-0-pro-250528
VIDEO_RESOLUTION=480p          # 480p | 720p | 1080p — dev default; never 1080p outside a deliberate test
VIDEO_DURATION_SECONDS=5
VIDEO_MAX_PER_SESSION=5        # hard cap on idle-loop generations per browser session

# --- Page-transition morphs (PLAN §3 Phase 5, experimental) ---
# Master switch, default false. Reuses VIDEO_PROVIDER/ARK_VIDEO_MODEL/VIDEO_RESOLUTION/
# VIDEO_DURATION_SECONDS above. Morphs are pre-generated in the background after a child page
# completes and cached on disk — a page navigation NEVER waits for one; a morph only ever plays
# on a later revisit of the same parent->child pair, after a first visit triggered generation.
MORPH_ENABLED=false
MORPH_MAX_PER_SESSION=5        # hard cap on morph generations per browser session

# --- Web search provider ---
SEARCH_PROVIDER=llm            # llm | none  (defaults to llm when LLM_API_KEY is set)
SEARCH_MODEL=cc/claude-sonnet-5

# --- House style (PLAN §2 VISUAL IDENTITY) ---
# Rendering style is a fixed constant (apps/server/src/prompts/house-style.md), not authored
# per-page by the LLM, so every page shares one look. felt | papercut | riso | pixel.
HOUSE_STYLE=felt

# --- Tap caching & reuse (PLAN §2.3) ---
# reuse (default): instant navigation to an existing child with the same tapped subject.
# variant: still skips repeat VLM calls per coordinate, but always regenerates a new child.
# off: disables both cache layers (matches the original's always-fresh behavior).
TAP_DEDUP=reuse

# --- Server ---
PORT=8787
DATABASE_URL=./data/flipbook.db
IMAGES_DIR=./data/images
