# --- LLM provider (prompt author + tap VLM) ---
LLM_PROVIDER=gemini            # gemini | mock
GEMINI_API_KEY=

# --- Image provider ---
IMAGE_PROVIDER=fal             # fal | mock
FAL_KEY=
IMAGE_MODEL=fal-ai/flux/schnell   # cheap default; set to fal-ai/nano-banana for quality

# --- Web search provider (stub only in Phase 1) ---
SEARCH_PROVIDER=none           # none

# --- Server ---
PORT=8787
DATABASE_URL=./data/flipbook.db
IMAGES_DIR=./data/images
