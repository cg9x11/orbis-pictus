node_modules/
dist/
build/
*.tsbuildinfo
.env
*.local

# reference-only asset used during reverse-engineering, not part of the build
ParisExampleVideo.mp4

# local runtime data (sqlite db, generated images, test scratch dirs) - ignore everything
# under here except the images/ placeholder, so nothing generated at runtime or by tests
# (e.g. a stray test-fixture db in a subdirectory) can slip into a commit.
apps/server/data/*
!apps/server/data/images/
apps/server/data/images/*
!apps/server/data/images/.gitkeep

# logs
npm-debug.log*
*.log

# editor
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
